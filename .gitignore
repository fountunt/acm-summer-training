# Linux compiled binaries (no extension, e.g. G.cpp -> ./G), recursive
**/*
!**/
!**/*.*

# Windows executables
*.exe

# VSCode settings (keep your personal settings local)
.vscode/settings.local.json

# Compiled binaries
*.o
*.out
*.obj
*.class
*.dll
*.pdb

# Documents / problem statements
*.pdf

# Logs / temporary files
*.log
*.tmp
*.bak

# Competitive Programming Helper (CPH) cache files
.cph/
divyanshuagrawal.competitive-programming-helper/

# Pending local work, not yet ready to share
codeforces/competition/1113/
模板/

# IDE / tool configs (local only, not uploaded)
.vscode/
.claude/

# VSCode C/C++ 调试配置(本机专用,不上传;即使将来去掉上面的 .vscode/ 兜底,这些也始终被忽略)
.vscode/settings.json
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/tasks.json
